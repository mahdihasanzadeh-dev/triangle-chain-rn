{
  "expo": {
    "name": "Triangle Chain",
    "slug": "triangle-chain-rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#100b07",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.trianglechain"
    },
    "android": {
      "package": "com.yourcompany.trianglechain",
      "adaptiveIcon": {
        "backgroundColor": "#100b07"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9a7b941c-5cbf-4d41-adc7-15290371390f"
      }
    }
  }
}
